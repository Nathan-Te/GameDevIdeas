{
  "name": "vitrine",
  "version": "1.0.0",
  "private": true,
  "description": "Vitrine — catalogue personnel d'idées de jeux",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "migrate": "npm run migrate --workspace server",
    "backup": "npm run backup --workspace server --",
    "restore": "npm run restore --workspace server --",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
